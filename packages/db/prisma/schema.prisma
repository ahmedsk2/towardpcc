// TowardPCC persistence model (v1). Design rationale + retention periods:
// docs/decisions/ADR-data-model.md. The calculators persist NOTHING (client-
// side only, PRD §6.4); this schema serves only the submission/admin surfaces.

generator client {
  // Queries run through the WASM query compiler over the pure-JS `pg` driver,
  // with no native Rust engine — required because Prisma ships no Windows-ARM64
  // engine (dev box), and fine on the Linux prod host. Enabled by passing an
  // adapter to PrismaClient (see src/index.ts).
  //
  // Prisma 6 needed `engineType = "client"` here to select that mode. Prisma 7
  // removed the Rust engine outright and made driver adapters mandatory, so the
  // setting no longer selects anything and has been dropped rather than left
  // behind as a line that reads like it still controls something.
  //
  // Still `prisma-client-js`, not the newer `prisma-client` generator: that one
  // requires an explicit `output` inside the repo and changes every import from
  // "@prisma/client" to a generated path. Deferred as its own decision.
  provider = "prisma-client-js"
}

// No `url` here: Prisma 7 rejects `datasource.url` in the schema outright
// (P1012). The connection string now lives in prisma.config.ts, which reads it
// from DATABASE_URL at CLI time.
datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  EDITOR
}

enum SubmissionType {
  SERVICE
  KNOWLEDGE_PILOT
  DATA_INTEREST
  CONTACT
}

enum SubmissionStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  CLOSED
  SPAM
}

/// Operator accounts for /admin. TOTP is mandatory (PRD §9); passwords are
/// Argon2id; totpSecret is application-encrypted on top of at-rest encryption.
model AdminUser {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  totpSecret        String // application-encrypted
  totpRecoveryCodes String[] // hashed, single-use
  lastTotpStep      BigInt? // last consumed TOTP period — blocks code replay (RFC 6238 §5.2)
  role              AdminRole        @default(EDITOR)
  failedLoginCount  Int              @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime         @default(now())
  lastLoginAt       DateTime?
  triaged           Submission[]     @relation("TriagedBy")
  auditLogs         AuditLog[]
  calcMetaEdits     CalculatorMeta[]
  settingEdits      AppSetting[]
}

/// Everything the public sends us. Free-form fields live in `payload` (JSONB),
/// validated server-side by a per-type Zod schema before write. Retention:
/// 24 months from createdAt, then purged (PRD §8.4).
model Submission {
  id            String           @id @default(cuid())
  type          SubmissionType
  payload       Json
  status        SubmissionStatus @default(NEW)
  internalNotes String? // admin-only; never shown to the submitter
  ipHash        String? // salted + truncated hash; abuse forensics only, not identity
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  triagedBy     AdminUser?       @relation("TriagedBy", fields: [triagedById], references: [id])
  triagedById   String?

  @@index([type, status])
  @@index([createdAt])
}

/// Editable presentation layer over the immutable scoring-engine. Governs
/// presentation + publish state only — never formulas or bands (engine-owned).
model CalculatorMeta {
  id               String     @id @default(cuid())
  slug             String     @unique // must match a registered engine score id
  published        Boolean    @default(false)
  displayOverrides Json? // presentation only
  validatorSlots   Json? // the two independent-validator slots (§6.4)
  updatedAt        DateTime   @updatedAt
  updatedBy        AdminUser? @relation(fields: [updatedById], references: [id])
  updatedById      String?
}

/// Append-only audit trail of every admin mutation (PRD §9). Code never updates
/// or deletes rows. Retention: 12 months from ts, then purged (§8.4).
model AuditLog {
  id      String    @id @default(cuid())
  actor   AdminUser @relation(fields: [actorId], references: [id])
  actorId String
  action  String
  entity  String // "table:id"
  diff    Json // before/after of changed fields, PII redacted
  ts      DateTime  @default(now())

  @@index([ts])
  @@index([entity])
}

/// Registry spine — designed now, dormant in v1 (no feature reads/writes these).
model Organization {
  id        String   @id @default(cuid())
  name      String
  country   String
  contact   String?
  createdAt DateTime @default(now())
  units     Unit[]
}

model Unit {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  picuBeds       Int?
  createdAt      DateTime     @default(now())
}

/// Operator-editable configuration, so the founder can set the mail relay from
/// the admin area instead of editing Coolify environment variables.
///
/// A key-value table rather than typed columns: the set of settings will grow,
/// and every addition would otherwise be a migration against a production
/// database whose app role deliberately has no DDL rights.
///
/// Values here OVERRIDE the environment. That direction is deliberate — the UI
/// is the thing an operator can actually reach, and a setting that silently
/// loses to an env var would be the worst kind of surprise. Deleting a row
/// falls back to the environment.
model AppSetting {
  key         String    @id
  value       String
  /// Whether `value` is an AES-256-GCM sealed box rather than plaintext.
  /// Only the SMTP password is sealed today.
  encrypted   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  updatedBy   AdminUser @relation(fields: [updatedById], references: [id])
  updatedById String
}
