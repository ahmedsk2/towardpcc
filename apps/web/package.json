{
  "name": "@towardpcc/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm --filter @towardpcc/db generate",
    "build": "next build --webpack",
    "start": "next start",
    "pretypecheck": "pnpm --filter @towardpcc/db generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
