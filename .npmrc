engine-strict=true
save-exact=false

# Do not install a version published in the last three days.
#
# The npm supply-chain attacks that matter to a project like this follow one
# shape: a maintainer account is compromised, a malicious patch release goes
# out, and it is caught and unpublished within hours. The only thing standing
# between that release and this repository is how quickly someone runs an
# install or merges a Dependabot bump — which, with automated dependency
# updates, can be minutes.
#
# Three days is chosen to cover that detection window without making ordinary
# work wait. It costs nothing in normal use: the versions being installed are
# almost always weeks or months old.
#
# THE ESCAPE HATCH MATTERS AS MUCH AS THE RULE. A genuine zero-day fix will
# also be brand new, and this would block it. When that happens, do not remove
# this setting — add the specific package to minimumReleaseAgeExclude, install,
# and take it back out. Removing the rule to unblock one package leaves it
# removed.
minimum-release-age=4320
