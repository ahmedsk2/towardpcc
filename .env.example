# ── TowardPCC environment ──────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env. Every variable used anywhere
# in the stack is documented here; keep this file current (working agreement).

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Structured-log verbosity (pino): trace|debug|info|warn|error. Defaults to info.
LOG_LEVEL=info

# PostgreSQL (main app database; dev runs in Docker)
POSTGRES_USER=towardpcc
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=towardpcc
DATABASE_URL=postgresql://towardpcc:change-me-dev-only@localhost:5432/towardpcc
# Production only: least-privilege app role the web container connects as (prod
# compose wires web → towardpcc_app; dev uses DATABASE_URL directly).
# Generate: openssl rand -hex 24
POSTGRES_APP_PASSWORD=change-me-dev-only

# Umami analytics (self-hosted, cookie-less; UI at http://localhost:3001)
UMAMI_DB_PASSWORD=change-me-dev-only
# Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=

# SMTP (dev: Mailpit in Docker — UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Prod relays through OCI Email Delivery in me-riyadh-1 and sends as the site's
# own domain. towardpcc.com publishes v=spf1 -all with DMARC p=reject/adkim=s,
# and that is CORRECT and stays: SPF is checked against the envelope MAIL FROM
# (an Oracle return-path domain), so the apex record is never consulted — a
# strict-aligned DKIM signature is what earns the DMARC pass.
# See docs/runbooks/email-delivery.md.
MAIL_FROM=TowardPCC <info@towardpicu.com>
# Only needed if From: is ever on a domain other than the one people write to.
MAIL_REPLY_TO=

# Secret the OCI load balancer injects as `x-via-edge` once the KSA edge
# migration lands (ADR-0004). Its presence is how lib/client-ip.ts tells the
# in-region path from the Cloudflare path. LEAVE THIS BLANK until the load
# balancer exists — unset means the edge path is unreachable, which is the
# safe default. Generate with: openssl rand -hex 32
EDGE_SHARED_SECRET=

# S3-compatible storage (dev: MinIO — console at http://localhost:9001)
MINIO_ROOT_USER=towardpcc
MINIO_ROOT_PASSWORD=change-me-dev-only
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=towardpcc-dev
S3_ACCESS_KEY=towardpcc
S3_SECRET_KEY=change-me-dev-only
AUTH_SECRET=
TOTP_ENC_KEY=
SUBMISSION_IP_SALT=
SMTP_SECURE=false
ADMIN_EMAIL=
